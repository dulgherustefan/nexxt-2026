# Copiază în .env și completează doar ce ai. Cheia Bedrock NU intră aici: stă în API_KEY.txt.
# Pasul 0 (28.10.2026): în UE, SCP-ul contului blochează Mantle; merge us-east-1.
AWS_REGION=us-east-1
MODEL_OPUS=anthropic.claude-opus-5-5
MODEL_SONNET=anthropic.claude-sonnet-5
MODEL_HAIKU=anthropic.claude-haiku-4-5
# auto = live dacă merge, altfel replay/offline; live; replay; offline
VERSOML_LLM_MODE=auto
# auto = surse reale cu rezervă pe înregistrări; live; fixture
VERSOML_OSINT_MODE=auto

# Opționale: deblochează mai multe surse OSINT
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_KEY=
